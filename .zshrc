#~~~~~~~~~~~~~~~~~~ Batcat config ~~~~~~~~~~~~~~~~~~#
export BAT_THEME="gruvbox-dark"


#~~~~~~~~~~~~~~~~~~ Aliases ~~~~~~~~~~~~~~~~~~#
alias cat='/opt/homebrew/bin/bat'
alias ll='lsd -lh --group-dirs=first'
alias la='lsd -a --group-dirs=first'
alias ls='lsd --group-dirs=first'
alias v='nvim'








eval "$(starship init zsh)"
